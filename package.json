{
  "name": "city-delivery-intelligent-dispatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "城市配送智能配载与运输调度优化：路线、三维装载、逐站装卸与人工确认。",
  "scripts": {
    "test": "npm run frontend:test",
    "frontend:dev": "vite --config frontend/vite.config.ts --host 127.0.0.1 --port 8111 --strictPort",
    "frontend:build": "vite build --config frontend/vite.config.ts",
    "frontend:test": "vitest run --config frontend/vitest.config.ts",
    "frontend:e2e": "playwright test --config frontend/playwright.city-delivery.config.ts",
    "frontend:e2e:city-delivery": "playwright test --config frontend/playwright.city-delivery.config.ts",
    "frontend:e2e:gis": "playwright test --config frontend/playwright.city-geo.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit",
    "licenses:report": "node scripts/generate-dependency-license-report.mjs",
    "licenses:verify": "node scripts/verify-licenses.mjs"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "three": "0.186.1"
  }
}
